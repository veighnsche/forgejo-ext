{{template "base/head" .}}
<main class="extension-workspace" data-extension-workspace data-app-sub-url="{{AppSubUrl}}" data-workspace-path="{{.WorkspacePath}}" data-workspace-session-generation="{{.WorkspaceSessionGeneration}}">
	<div class="ui container extension-workspace-notices">{{template "base/alert" .}}</div>
	<div class="extension-workspace-layout">
		<iframe class="extension-workspace-frame" title="Forgejo pages" data-extension-workspace-frame sandbox="allow-same-origin allow-scripts allow-forms allow-downloads allow-modals allow-popups allow-top-navigation-by-user-activation"></iframe>
		{{if .ExtensionPanels}}
		<aside id="extension-workspace-panels" class="extension-workspace-panels" aria-label="Workspace panels">
			{{range .ExtensionPanels}}
			<section class="extension-workspace-panel" aria-labelledby="extension-panel-{{.ExtensionID}}-{{.ID}}">
				<h2 id="extension-panel-{{.ExtensionID}}-{{.ID}}">{{.Title}}</h2>
				<div data-extension-panel data-app-sub-url="{{AppSubUrl}}" data-extension-id="{{.ExtensionID}}" data-extension-panel-id="{{.ID}}" data-extension-entry="{{.Entry}}" data-extension-api-base="{{.APIBase}}" data-extension-asset-base="{{.AssetBase}}" data-extension-session-generation="{{$.WorkspaceSessionGeneration}}"{{if $.ExtensionRepositoryID}} data-extension-repository-id="{{$.ExtensionRepositoryID}}"{{end}}></div>
			</section>
			{{end}}
		</aside>
		{{end}}
	</div>
</main>
{{template "base/footer" .}}
