{{if .ExtensionPanelsHome}}
<aside id="extension-panels" class="extension-workspace-panels" aria-label="Workspace panels" data-extension-panels data-app-sub-url="{{AppSubUrl}}" data-extension-session-generation="{{.ExtensionSessionGeneration}}"{{if not .PageIsWorkspacePage}} hidden inert{{end}}>
	{{range .ExtensionPanels}}
	<section class="extension-workspace-panel" aria-labelledby="extension-panel-{{.ExtensionID}}-{{.ID}}">
		<h2 id="extension-panel-{{.ExtensionID}}-{{.ID}}">{{.Title}}</h2>
		<div data-extension-panel data-extension-contract-version="{{$.BrowserContractVersion}}" data-app-sub-url="{{AppSubUrl}}" data-extension-id="{{.ExtensionID}}" data-extension-panel-id="{{.ID}}" data-extension-entry="{{.Entry}}" data-extension-api-base="{{.APIBase}}" data-extension-asset-base="{{.AssetBase}}" data-extension-session-generation="{{$.ExtensionSessionGeneration}}"{{if $.ExtensionRepositoryID}} data-extension-repository-id="{{$.ExtensionRepositoryID}}"{{end}}></div>
	</section>
	{{end}}
</aside>
{{end}}
